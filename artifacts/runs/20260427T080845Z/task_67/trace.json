        "code": "import csv\n\ntotal_weight = 0\ncount = 0\n\nwith open('csv/superhero.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        if row['gender_id'] == '2':\n            weight = row['weight_kg']\n            if weight and weight != '':\n                total_weight += float(weight)\n                count += 1\n\nif count > 0:\n    average = total_weight / count\n    print(f'Female superheroes: {count}, Total weight: {total_weight}, Average: {average}')\nelse:\n    print('No female superheroes found with valid weight')"
