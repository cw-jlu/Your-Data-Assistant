abnormal/elevated\nABNORMAL_THRESHOLD = 1.2\n\n# Reference date for age calculation (use a fixed date like 2000-01-01 or current date)\nreference_date = datetime(2000, 1, 1)\n\n# Find patients with abnormal creatinine who are under 70\nunder_70_abnormal_count = 0\nabnormal_patients = []\n\nfor pid, cr in lab_data.items():\n    if cr > ABNORMAL_THRESHOLD:\n        # This patient has abnormal creatinine\n        if pid in patient_birthdates:\n            year, month, day = patient_birthdates[pid]\n            birth_date = datetime(year, month, day)\n            age = reference_date.year - birth_date.year\n            # Adjust for whether birthday has passed in reference year\n            if (reference_date.month, reference_date.day) < (month, day):\n                age -= 1\n            \n            if age < 70:\n                under_70_abnormal_count += 1\n                abnormal_patients.append((pid, cr, age))\n                print(f\"Patient {pid}: Creatinine={cr}, Age={age} (under 70)\")\n            else:\n                print(f\"Patient {pid}: Creatinine={cr}, Age={age} (70 or older)\")\n        else:\n            print(f\"Patient {pid}: Creatinine={cr} (no birthdate found)\")\n\nprint(f\"\\nTotal patients with abnormal creatinine under 70: {under_70_abnormal_count}\")"}}
