        "code": "import csv\nimport json\n\n# Read qualifying data\nwith open('csv/qualifying.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    race_19_q2 = []\n    for row in reader:\n        if row['raceId'] == '19' and row['q2']:\n            # Parse time like \"1:34.412\" to seconds\n            time_str = row['q2']\n            parts = time_str.split(':')\n            seconds = int(parts[0]) * 60 + float(parts[1])\n            race_19_q2.append({'driverId': row['driverId'], 'time_seconds': seconds, 'time_str': time_str})\n\n# Find best lap time (lowest)\nbest = min(race_19_q2, key=lambda x: x['time_seconds'])\nprint(f\"Best q2 time for race 19: {best['time_str']} ({best['time_seconds']}s), driverId: {best['driverId']}\")\n\n# Read drivers data\nwith open('json/drivers.json', 'r') as f:\n    drivers = json.load(f)\n\n# Find driver with matching driverId\nfor driver in drivers:\n    if str(driver['driverId']) == str(best['driverId']):\n        print(f\"Driver name: {driver['name']}, surname: {driver['surname']}\")\n        break"
